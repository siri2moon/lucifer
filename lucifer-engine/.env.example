# Copy to .env and fill in what you need. Every variable is optional:
# with no LLM key the engine runs the free simulation brain.

# --- LLM ---------------------------------------------------------------------
# LUCIFER_LLM=gateway          # anthropic | gateway. Defaults to gateway when CF_AIG_* is set
# LUCIFER_BRAIN=auto           # auto | crew | sim. auto uses crew when a key is present, sim otherwise

# --- Cloudflare AI Gateway (DeepSeek, OpenAI, Gemini…) ------------------------
CF_AIG_ACCOUNT_ID=
CF_AIG_GATEWAY_ID=default
CF_AIG_TOKEN=                  # Cloudflare API token; enough on its own when the provider key is stored on the gateway (BYOK)
# CF_AIG_BYOK_ALIAS=           # alias of the stored provider key, if it is not named "default"
# CF_AIG_PROVIDER_KEY=         # provider key when it is not stored on the gateway; the token then goes in cf-aig-authorization
# CF_AIG_BASE_URL=             # override the whole .../compat URL (e.g. a custom domain)
LUCIFER_MODEL=deepseek/deepseek-chat   # or dynamic/<route> to pick the model on the gateway
# LUCIFER_STRICT_TOOLS=0       # 1 only for OpenAI models

# --- Anthropic (Claude) directly ----------------------------------------------
# ANTHROPIC_API_KEY=
# LUCIFER_FALLBACKS=1          # server-side fallback when the safety classifier declines a request

# --- Runtime ------------------------------------------------------------------
# LUCIFER_COMPANY=companies/lucifer-corp.yaml
# HOST=0.0.0.0
# PORT=4666
# LUCIFER_HEARTBEAT_MS=2000
# LUCIFER_MAX_CONCURRENT=4
# LUCIFER_DATA_DIR=data
# LUCIFER_WORKSPACE_DIR=workspace
